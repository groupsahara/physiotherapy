# ── Deployment ──────────────────────────────────────────────────────────
# Public origin of the deployed site (canonical URLs, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Backend API / CMS (server-only) ─────────────────────────────────────
# Everything the site shows comes from `GET $API_URL/api/v1/public/site`, and appointment
# requests go to `POST $API_URL/api/v1/public/enquiries`. Default: http://localhost:3000
API_URL=http://localhost:3000

# Sent as `x-site-key` with appointment requests. Must equal the backend's WEBSITE_API_KEY
# (leave both empty to disable the check).
WEBSITE_API_KEY=

# Shared secret for `POST /api/revalidate` (header `x-revalidate-secret`), which the backend
# calls after every content change. Must equal the backend's WEBSITE_REVALIDATE_SECRET, and the
# backend's WEBSITE_REVALIDATE_URL must point at https://<this site>/api/revalidate.
# Unset → the endpoint answers 503 and content refreshes on its own within an hour.
REVALIDATE_SECRET=

# Extra origins (comma-separated) allowed to serve optimised CMS images, e.g. the backend's
# MEDIA_PUBLIC_BASE_URL when it differs from API_URL, or a CDN. `$API_URL/media/**` is always
# allowed. Read when the site is built/started. Images from any other host still display,
# just without optimisation.
MEDIA_ORIGINS=

# Google Maps Embed API key for the contact-section map (public: inlined at build and visible in
# the page). Restrict it in Google Cloud to HTTP referrers of this site and to the Maps Embed API.
# Unset → the key-less embed is used.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Extra appointment channels (all optional) ───────────────────────────
# The backend enquiries inbox is the primary channel. These add copies of each request.

# Email the clinic via Resend (https://resend.com). Verify your sending domain in Resend.
RESEND_API_KEY=
# Defaults to the clinic email from the CMS.
APPOINTMENT_EMAIL_TO=
# Defaults to "<clinic name> <onboarding@resend.dev>".
APPOINTMENT_EMAIL_FROM=

# POST each request as JSON to a webhook (Slack, Discord, Zapier, Make,
# or a Google Apps Script that appends rows to a Google Sheet).
APPOINTMENT_WEBHOOK_URL=
