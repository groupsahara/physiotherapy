# Public origin of the deployed site (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Appointment delivery (all optional) ────────────────────────────────
# Without any of these, bookings are only logged on the server and patients
# are asked to confirm on WhatsApp / by phone.

# Email the clinic via Resend (https://resend.com). Verify your sending domain
# in Resend, then set FROM to an address on that domain.
RESEND_API_KEY=
APPOINTMENT_EMAIL_TO=movingcure24@gmail.com
APPOINTMENT_EMAIL_FROM="Moving Cure Website <bookings@your-domain.com>"

# POST each booking as JSON to a webhook (Slack, Discord, Zapier, Make,
# or a Google Apps Script that appends rows to a Google Sheet).
APPOINTMENT_WEBHOOK_URL=
